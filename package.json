{
  "name": "easymint",
  "version": "0.12.1",
  "description": "AI 项目工作台 — 基于 Pi Agent Core 的智能编程助手，让不懂技术的人也能构建软件",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/tianemon/EasyMint",
  "main": "app/main/dist/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"node node_modules/vite/bin/vite.js --config app/renderer/vite.config.ts\" \"node scripts/dev-electron.cjs\"",
    "dev:renderer": "node node_modules/vite/bin/vite.js --config app/renderer/vite.config.ts",
    "dev:electron": "npm run build:main && npm run build:preload && node node_modules/electron/cli.js .",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload && electron-builder",
    "build:mac": "npm run build:renderer && npm run build:main && npm run build:preload && electron-builder --mac && rm -rf dist-electron/mac* dist-electron/*.zip*",
    "build:ci": "npm run build:renderer && npm run build:main && npm run build:preload && electron-builder --publish never",
    "build:renderer": "vite build --config app/renderer/vite.config.ts",
    "build:main": "esbuild app/main/index.ts --bundle --platform=node --format=cjs --outfile=app/main/dist/main.cjs --external:electron --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-agent-core --external:@earendil-works/pi-ai --external:@earendil-works/pi-ai/compat --external:@modelcontextprotocol/sdk --external:@modelcontextprotocol/sdk/* --external:electron-updater --external:@aws-sdk/* --external:archiver --external:unzipper",
    "build:preload": "esbuild app/preload/index.ts --bundle --platform=node --format=cjs --outfile=app/preload/dist/preload.cjs --external:electron",
    "lint": "eslint app/ && tsc --noEmit -p app/main/tsconfig.json && tsc --noEmit -p app/preload/tsconfig.json && tsc --noEmit -p app/renderer/tsconfig.json",
    "typecheck": "tsc --noEmit -p app/main/tsconfig.json && tsc --noEmit -p app/preload/tsconfig.json && tsc --noEmit -p app/renderer/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.3",
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.14.9",
    "archiver": "^8.0.0",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "unzipper": "^0.12.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@dvaji/vite-plugin-monaco-editor": "^2.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "monaco-editor": "^0.56.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.easymint.app",
    "productName": "EasyMint",
    "icon": "assets/icon.icns",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "app/main/dist/**/*",
      "app/preload/dist/**/*",
      "app/renderer/dist/**/*",
      "assets/icon.icns",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json",
      "node_modules/@earendil-works/**/*",
      "node_modules/@oh-my-pi/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/archiver/**/*",
      "node_modules/unzipper/**/*"
    ],
    "asarUnpack": [
      "node_modules/@earendil-works/**",
      "node_modules/@oh-my-pi/**"
    ],
    "publish": {
      "provider": "github"
    },
    "extraResources": [
      {
        "from": "template",
        "to": "template"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/em-html-editor",
        "to": "em-html-editor"
      },
      {
        "from": "resources/brand-tokens",
        "to": "brand-tokens"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "${productName}-macOS-${arch}.${ext}",
      "notarize": false,
      "signIgnore": [
        "brand-tokens/linear.app"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": true,
      "artifactName": "${productName}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "scripts/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-windows-${arch}-portable.${ext}"
    }
  }
}
