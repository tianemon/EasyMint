{
  "name": "easymint",
  "version": "1.4.3",
  "description": "AI 项目工作台 — 基于 Pi Agent Core 的智能编程助手，让不懂技术的人也能构建软件",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/tianemon/EasyMint",
  "main": "app/main/dist/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"node node_modules/vite/bin/vite.js --config app/renderer/vite.config.ts\" \"node scripts/dev-electron.cjs\"",
    "dev:isolated": "EASYMINT_HOME=$HOME/.easymint-dev npm run dev",
    "dev:renderer": "node node_modules/vite/bin/vite.js --config app/renderer/vite.config.ts",
    "dev:electron": "npm run build:main && npm run build:preload && node node_modules/electron/cli.js .",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload && electron-builder",
    "build:mac": "npm run build:renderer && npm run build:main && npm run build:preload && electron-builder --mac && rm -rf dist-electron/mac* dist-electron/*.zip*",
    "build:linux": "npm run build:renderer && npm run build:main && npm run build:preload && electron-builder --linux",
    "build:ci": "npm run build:renderer && npm run build:main && npm run build:preload && electron-builder --publish never",
    "postinstall": "node scripts/patch-pi-config.cjs && node scripts/patch-sandbox-runtime.cjs && node scripts/patch-pi-mcp.cjs",
    "build:renderer": "vite build --config app/renderer/vite.config.ts",
    "build:main": "node scripts/build.cjs main",
    "build:preload": "node scripts/build.cjs preload",
    "lint": "eslint app/ --cache && concurrently --kill-others-on-fail --names main,preload,renderer \"tsc --noEmit -p app/main/tsconfig.json\" \"tsc --noEmit -p app/preload/tsconfig.json\" \"tsc --noEmit -p app/renderer/tsconfig.json\" && node scripts/check-deps.mjs && node scripts/check-em-home-paths.mjs && node scripts/gen-brand-index.mjs --check && node scripts/check-i18n.mjs && node scripts/gen-editor-i18n.mjs --check && npm run check:visual-design",
    "check:i18n": "node scripts/check-i18n.mjs && node scripts/gen-editor-i18n.mjs --check",
    "check:deps": "node scripts/check-deps.mjs",
    "check:em-home": "node scripts/check-em-home-paths.mjs",
    "gen:brands": "node scripts/gen-brand-index.mjs",
    "check:brands": "node scripts/gen-brand-index.mjs --check",
    "typecheck": "concurrently --kill-others-on-fail --names main,preload,renderer \"tsc --noEmit -p app/main/tsconfig.json\" \"tsc --noEmit -p app/preload/tsconfig.json\" \"tsc --noEmit -p app/renderer/tsconfig.json\"",
    "test": "vitest run",
    "check:visual-brands": "node scripts/gen-visual-brands.cjs --check",
    "check:visual-design": "node scripts/gen-visual-brands.cjs --check && node scripts/gen-visual-templates.mjs --check",
    "install:deps": "node scripts/install-deps.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.75",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "archiver": "^8.0.0",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "i18next": "26.4.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "parse5": "8.0.1",
    "pdf-parse": "^2.4.5",
    "proper-lockfile": "4.1.2",
    "semver": "7.8.5",
    "shell-quote": "^1.10.0",
    "undici": "^7.29.1",
    "unzipper": "^0.12.5",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dvaji/vite-plugin-monaco-editor": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.8.0",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.4",
    "dompurify": "^3.4.15",
    "electron": "^43.7.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.11.0",
    "happy-dom": "21.0.4",
    "marked": "^18.0.13",
    "monaco-editor": "^0.56.0",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "17.0.16",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.10",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "yaml": "2.9.0",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.easymint.app",
    "productName": "EasyMint",
    "icon": "assets/icon.icns",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "app/main/dist/**/*",
      "app/preload/dist/**/*",
      "app/renderer/dist/**/*",
      "assets/icon.icns",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json",
      "node_modules/@anthropic-ai/**/*",
      "node_modules/@earendil-works/**/*",
      "node_modules/@oh-my-pi/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/archiver/**/*",
      "node_modules/unzipper/**/*",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.md",
      "!node_modules/openai/src/**",
      "!node_modules/@anthropic-ai/sdk/src/**",
      "!node_modules/@earendil-works/pi-coding-agent/{docs,examples}/**"
    ],
    "asarUnpack": [
      "app/main/dist/windows-sandbox-worker.cjs",
      "node_modules/@anthropic-ai/sandbox-runtime/vendor/**",
      "node_modules/@earendil-works/pi-tui/native/**",
      "node_modules/@oh-my-pi/**",
      "node_modules/quickjs-wasi/**"
    ],
    "publish": {
      "provider": "github"
    },
    "extraResources": [
      {
        "from": "template",
        "to": "template"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/em-html-editor",
        "to": "em-html-editor"
      },
      {
        "from": "assets/appicon-light.png",
        "to": "appicon-light.png"
      },
      {
        "from": "assets/appicon-dark.png",
        "to": "appicon-dark.png"
      },
      {
        "from": "resources/visual-design",
        "to": "visual-design"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "${productName}-macOS-${arch}.${ext}",
      "notarize": false,
      "signIgnore": [
        "skills/brand-tokens/brands/linear.app"
      ]
    },
    "dmg": {
      "icon": "assets/icon-volume.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "${productName}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "scripts/installer.nsh"
    },
    "afterPack": "scripts/after-pack.cjs",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "maintainer": "EasyMint <dev@easymint.app>",
      "category": "Development",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-linux-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "bubblewrap",
        "socat",
        "ripgrep"
      ],
      "recommends": [
        "libappindicator3-1",
        "apparmor-profiles"
      ],
      "afterInstall": "build/linux-after-install.sh"
    }
  }
}
