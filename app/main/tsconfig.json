{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "..",
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "../shared/**/*.ts"],
  "exclude": [
    "vendor/**",
    "services/task/executor.ts",
    "services/task/parallel.ts"
  ]
}
